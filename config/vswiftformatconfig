# ════════════════════════════════════════════════════════════
# SwiftFormat 配置
# 校验: swiftformat --lint --config <本文件> <路径>
# ════════════════════════════════════════════════════════════

# ── file options ──

--exclude Tests/XCTestManifests.swift,Tests/BadConfig,Snapshots,Build,PluginTests

# ── format options（对应规则已启用，实际生效）──

--allman false
--binarygrouping 4,8
--commas always
--decimalgrouping 3,6
--elseposition same-line
--emptybraces no-space
--exponentcase lowercase
--exponentgrouping disabled
--fractiongrouping disabled
--header ignore
--hexgrouping 4,8
--hexliteralcase uppercase
--importgrouping testable-bottom
--lineaftermarks false
--linebreaks lf
--maxwidth 120
--octalgrouping 4,8
--operatorfunc spaced
--patternlet hoist
--ranges preserve
--self remove
--semicolons inline
--stripunusedargs always
--swiftversion 6.2

# ── 以下选项依赖 indent / trailingSpace / wrapArguments 规则，
#    这些规则因「生成代码/转模型」被刻意禁用（见底部），故当前不生效，
#    保留以记录预期值，便于将来对生成目录改用 --exclude 后再启用 ──

--indent 4
--tabwidth 4
--indentcase false
--ifdef indent
--xcodeindentation enabled
--smarttabs enabled
--trimwhitespace always
--wraparguments before-first
--wrapcollections preserve
--wrapconditions preserve
--typeblanklines preserve

# ── disabled rules ──

# 生成代码/转模型相关：全局格式化会破坏生成代码，刻意禁用
# （正解是给生成目录加 --exclude 后再启用，此处按团队现状保守保留）
--disable indent              # 缩进
--disable trailingSpace       # 尾随空格
--disable consecutiveSpaces   # 连续空格（转模型对齐）
--disable redundantType       # 保留模型属性的显式类型

# 依赖 indent：indent 关闭时启用会产生错误缩进，故一并禁用
--disable wrapArguments
--disable wrapMultilineStatementBraces

# opt-in / 有副作用：按最佳实践保持关闭
--disable trailingClosures            # 可能改变语义
--disable blockComments               # 块注释转行注释，过于激进
--disable blankLinesBetweenImports
--disable headerFileName              # header=ignore，规则无意义

# 入口点安全：禁止格式化 hook 静默替换 @UIApplicationMain
--disable applicationMain
