#!/bin/bash

set -uo pipefail

HOOKS_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$(dirname "$HOOKS_DIR")"
FORMAT_CONFIG="$ROOT_DIR/config/clang-format-config"
OUTPUT_DIR="${HOME}/Library/Caches/vshow"
FORMAT_OUTPUT="$OUTPUT_DIR/objc-format-output.diff"

if ! command -v python3 >/dev/null 2>&1; then
    echo "❌ Objective-C代码格式校验执行失败: 未找到 python3"
    exit 2
fi

CLANG_FORMAT="$(xcrun --find clang-format 2>/dev/null || true)"
if [ -z "$CLANG_FORMAT" ] || [ ! -x "$CLANG_FORMAT" ]; then
    echo "❌ Objective-C代码格式校验执行失败: 未找到 Xcode clang-format"
    exit 2
fi

mkdir -p "$OUTPUT_DIR"
exec python3 "$HOOKS_DIR/check_objc_format.py" \
    --clang-format "$CLANG_FORMAT" \
    --style "$FORMAT_CONFIG" \
    --output "$FORMAT_OUTPUT"
